{
  "name": "openapi-smoke",
  "version": "0.1.0",
  "description": "Generate safe API smoke checks from an OpenAPI spec with explicit base URL and GET-only defaults.",
  "type": "module",
  "bin": { "openapi-smoke": "dist/cli.js" },
  "scripts": { "build": "tsc", "dev": "tsx src/cli.ts", "test": "vitest run", "lint": "tsc --noEmit", "prepack": "npm run build" },
  "keywords": ["cli", "openapi", "smoke-test", "api", "developer-tools"],
  "license": "MIT",
  "dependencies": { "@apidevtools/swagger-parser": "^10.1.0", "commander": "^12.1.0", "picocolors": "^1.0.1" },
  "devDependencies": { "@types/node": "^22.10.2", "tsx": "^4.19.2", "typescript": "^5.7.2", "vitest": "^4.1.7" },
  "engines": { "node": ">=20" },
  "files": ["dist", "README.md", "LICENSE"]
}
